datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---- Enums ----
//
// Grade values like "jun-", "jun+" contain non-identifier characters that are
// not valid for Postgres native enums; grade therefore stays as a String,
// validated at the API edge via Zod (see lib/schemas.ts).

enum UserRole {
  USER
  ASSESSOR
  MANAGER
  ADMIN
}

enum AssessmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssessmentReviewStatus {
  NONE // default — not submitted for admin review
  PENDING // assessor ended the assessment; awaiting admin decision
  REVIEWED // admin recorded an upgrade / no-upgrade decision
}

enum AssessmentTypeEnum {
  GENERAL
  PDP_CHECK
}

enum ParticipantRole {
  SUBJECT
  ASSESSOR
}

enum SessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum PdpStatus {
  GENERATING
  ON_REVIEW
  DRAFT
  ACTIVE
  COMPLETED
  FAILED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  REQUEST_SUBMITTED // -> admins: a user requested an assessment
  ASSESSMENT_ASSIGNED // -> assessor: assigned to an assessment
  REQUEST_APPROVED // -> requester: request approved
  REQUEST_REJECTED // -> requester: request rejected
  ASSESSMENT_REVIEW_SUBMITTED // -> admins: assessment finished, grade needs review
  HRM_SYNC_FAILED // -> admins: nightly HRM sync aborted/failed (S04)
  HRM_ROLE_GRANTED // -> admins: HRM sync auto-granted ADMIN to someone (S05)
}

// ---- Models ----

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  role                 UserRole  @default(USER)
  grade                String? // "jun-" / "jun" / "jun+" / "mid-" / ... see lib/grades.ts
  project              String?
  isArchived           Boolean   @default(false) // left the department; kept for historical assessments
  managerId            String?
  googleId             String?   @unique // Google account id (OAuth `sub`); used to @mention/add the user in Google Chat
  googleAccessToken    String?
  googleRefreshToken   String?
  googleTokenExpiresAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  hrmEmployeeId Int?      @unique // employee.id
  jobTitle      String? // resolved via jobTitle dictionary; exact source field decided by S03 (see hrm-payloads/employees-search.schema.md)
  photoFileName String? // path like "photos/<uuid>.jpeg"; source decided by S04 (two mechanisms, see hrm-payloads/photos.schema.md)
  projects      String[]  @default([]) // legacy `project` scalar stays; sync only writes `projects`
  hrmManagerId  Int? // raw manager id before resolution; exact source field decided by S03
  hrmSyncedAt   DateTime? // last time this row was refreshed from HRM; null = "not found in HRM"
  hrmDismissed  Boolean   @default(false) // employee.lifecycleStatus == DELETED (confirmed)

  manager              User?                       @relation("manages", fields: [managerId], references: [id], onDelete: SetNull)
  reports              User[]                      @relation("manages")
  participations       AssessmentParticipant[]
  pdps                 Pdp[]
  createdPdps          Pdp[]                       @relation("createdPdps")
  reviewedAssessments  Assessment[]                @relation("reviewedAssessments")
  requestedAssessments AssessmentRequest[]         @relation("requestedBy")
  requestAssessors     AssessmentRequestAssessor[]
  apiTokens            ApiToken[]
  notifications        Notification[]
  certificates         Certificate[]
  roadmapProgress      RoadmapProgress[]
  departments          UserDepartment[]
  headedDepartments    Department[]                @relation("departmentHead")
  deputyDepartments    Department[]                @relation("departmentDeputy")
  roleAudit            RoleAuditLog[]              @relation("roleAuditSubject")
  roleAuditActions     RoleAuditLog[]              @relation("roleAuditActor")

  @@index([managerId])
  @@index([hrmEmployeeId])
  @@index([isArchived])
  @@index([name])
}

/// Org unit from HRM (`GET /org-units`).
/// Never hard-deleted: a DELETED type flips isActive=false, references stay live.
model Department {
  id             String   @id @default(cuid())
  hrmId          Int      @unique // orgUnit.id — idempotency key
  name           String // orgUnit.orgUnitName ← was "name" in the earlier comment
  orgUnitTypeId  Int?
  typeName       String? // orgUnitTypeDto.orgUnitTypeName
  isFilterable   Boolean  @default(true) // orgUnitTypeDto.isFilterable
  isSinglePerson Boolean  @default(false) // orgUnitTypeDto.isSinglePerson — single-seat positions (CEO/CTO)
  parentHrmId    Int? // reportsToId, raw id before resolution; may not resolve (see risks)
  parentId       String? // resolved in a second pass
  path           String   @default("")
  depth          Int      @default(0)
  headUserId     String?
  deputyUserId   String?
  isActive       Boolean  @default(true) // orgUnitTypeDto.lifecycleStatus != DELETED ← was the unit's own "lifecycleStatus" (no such field exists)
  syncedAt       DateTime @updatedAt

  parent   Department?      @relation("depTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[]     @relation("depTree")
  head     User?            @relation("departmentHead", fields: [headUserId], references: [id], onDelete: SetNull)
  deputy   User?            @relation("departmentDeputy", fields: [deputyUserId], references: [id], onDelete: SetNull)
  members  UserDepartment[]

  @@index([parentId])
  @@index([isActive])
  @@index([path])
}

/// A person's membership in a unit. Confirmed by a live run: an employee
/// genuinely has several orgUnits[] entries (~2.6 on average over a 60-person
/// sample, see hrm-payloads/employees-search.schema.md) — there's no "primary" unit.
model UserDepartment {
  userId       String
  departmentId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
}

/// Log of sync runs.
model HrmSyncRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String // RUNNING | SUCCESS | PARTIAL | FAILED | ABORTED_GUARD | DRY_RUN
  trigger    String // CRON | MANUAL | LOGIN
  dryRun     Boolean   @default(false)

  employeesSeen       Int @default(0)
  usersCreated        Int @default(0)
  usersUpdated        Int @default(0)
  usersDismissed      Int @default(0)
  usersRestored       Int @default(0)
  departmentsUpserted Int @default(0)
  membershipsAdded    Int @default(0)
  membershipsRemoved  Int @default(0)
  rolesGranted        Int @default(0)
  adminsGranted       Int @default(0)
  managersResolved    Int @default(0)

  failureReason String?
  report        Json?

  issues HrmSyncIssue[]

  @@index([startedAt])
  @@index([status])
}

/// A single "needs a human look" record — feeds the Exceptions tab (S07).
/// PARENT_UNRESOLVED is not hypothetical: on a live sample, 44 of 436 units
/// have a reportsToId pointing at an id absent from that same HRM response.
model HrmSyncIssue {
  id            String   @id @default(cuid())
  runId         String
  kind          String // NO_CORP_EMAIL | DUPLICATE_EMAIL | GRADE_UNMAPPED |
  // MANAGER_UNRESOLVED | PARENT_UNRESOLVED | HEAD_UNRESOLVED
  hrmEmployeeId Int?
  email         String?
  userId        String?
  message       String
  createdAt     DateTime @default(now())

  run HrmSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([kind])
}

/// Audit of every role change — automatic or manual.
/// hrmField is a free-form string; reference values live in
/// hrm-payloads/employees-search.schema.md (manager | managerM1..M5 |
/// employeeManagers[].managerType.type | headId) — NOT what the original spec
/// assumed (fields like employeeManagerId don't exist in the response).
model RoleAuditLog {
  id           String   @id @default(cuid())
  userId       String
  previousRole UserRole
  newRole      UserRole
  source       String // HRM_SYNC | MANUAL
  hrmField     String?
  runId        String?
  actorId      String?
  createdAt    DateTime @default(now())

  user  User  @relation("roleAuditSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("roleAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([newRole])
}

/// A certificate a user adds to their profile. Stored as the bare code
/// (e.g. "5Y0FT4E8X7GG9F6T"); the public verification URL is derived as
/// `${CERT_VERIFY_BASE_URL}${code}` (see lib/certificates.ts).
model Certificate {
  id        String   @id @default(cuid())
  userId    String
  code      String
  /// When true, this certificate is shown on the owner's user profile page
  /// (visible to anyone who can view that profile). Off by default — a private
  /// certificate the owner has added but not published.
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
}

/// Personal access tokens for programmatic API access (no Google OAuth).
/// Only the SHA-256 hash is stored. Token inherits the owning user's role/permissions.
model ApiToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Assessment {
  id                   String                 @id @default(cuid())
  title                String
  status               AssessmentStatus       @default(PLANNED)
  assessmentType       AssessmentTypeEnum     @default(GENERAL)
  grade                String
  scheduledAt          DateTime?
  completedAt          DateTime?
  notes                String?
  aiFeedback           String?
  pdpTopics            Json?
  // Admin review of a finished assessment: the assessor "ends" it (PENDING),
  // then an admin decides whether to upgrade the subject's grade (REVIEWED).
  reviewStatus         AssessmentReviewStatus @default(NONE)
  submittedForReviewAt DateTime?
  reviewedAt           DateTime?
  reviewedById         String?
  reviewNotes          String?
  gradeUpgraded        Boolean                @default(false)
  previousGrade        String? // subject grade captured at decision time (audit)
  newGrade             String? // chosen grade when upgraded (audit)
  // Admin-only cancellation with a mandatory reason.
  cancellationReason   String?
  cancelledAt          DateTime?
  cancelledById        String?
  /// Optional Google Calendar guest auto-invited to every Meet for this
  /// assessment. Falls back to OPTIONAL_MEETING_GUEST_EMAIL env var when
  /// unset. Empty string and null both mean "no guest".
  optionalGuestEmail   String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  participants    AssessmentParticipant[]
  results         AssessmentResult[]
  selfAssessments SelfAssessment[]
  pdps            Pdp[]
  sessions        AssessmentSession[]
  request         AssessmentRequest?
  reviewedBy      User?                   @relation("reviewedAssessments", fields: [reviewedById], references: [id])

  @@index([reviewStatus])
}

model AssessmentParticipant {
  id               String          @id @default(cuid())
  assessmentId     String
  userId           String
  participantRole  ParticipantRole
  assignedSections Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([assessmentId, userId, participantRole])
  @@index([userId])
}

model AssessmentResult {
  id           String   @id @default(cuid())
  assessmentId String
  category     String
  score        Float?
  comment      String?
  subtopics    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, category])
}

model Pdp {
  id               String    @id @default(cuid())
  userId           String
  createdById      String?
  assessmentId     String?
  fileName         String
  driveFileId      String?
  driveLink        String?
  status           PdpStatus @default(DRAFT)
  error            String?
  reviewNotes      String?
  topicsJson       Json
  // Original generation inputs ({ topicIds, customTopics }) so a FAILED pdp can
  // be retried in place without re-selecting topics. Null for legacy rows.
  generationInputs Json?
  startedAt        DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id])
  createdBy  User?       @relation("createdPdps", fields: [createdById], references: [id])
  assessment Assessment? @relation(fields: [assessmentId], references: [id])

  @@index([userId])
  @@index([assessmentId])
  @@index([status])
}

model AssessmentRequest {
  id             String             @id @default(cuid())
  userId         String
  status         RequestStatus      @default(PENDING)
  assessmentType AssessmentTypeEnum @default(GENERAL)
  grade          String
  notes          String?
  adminNotes     String?
  assessmentId   String?            @unique
  chatSpaceName  String? // Google Chat space resource name ("spaces/AAAA…") for this assessment's notification thread
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user       User                        @relation("requestedBy", fields: [userId], references: [id])
  assessment Assessment?                 @relation(fields: [assessmentId], references: [id])
  assessors  AssessmentRequestAssessor[]
}

/**
 * Many-to-many between AssessmentRequest and User (the assigned assessors).
 * Replaces the old `AssessmentRequest.assessorId` (singular FK) +
 * `AssessmentRequest.assessorIds` (JSON array, no FK enforcement) pair so we
 * get proper foreign-key guarantees and queryability.
 */
model AssessmentRequestAssessor {
  id         String   @id @default(cuid())
  requestId  String
  assessorId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  request  AssessmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assessor User              @relation(fields: [assessorId], references: [id])

  @@unique([requestId, assessorId])
  @@index([assessorId])
}

model AssessmentSession {
  id                 String        @id @default(cuid())
  assessmentId       String
  // Slug of the session kind (e.g. "TECHNICAL_1", "PDP_TECH", or an
  // admin-defined key). Was an enum; now free-form so admins can define
  // arbitrary session types via SessionTemplate.
  type               String
  // Display name captured from the SessionTemplate at creation time so
  // renaming a template never rewrites historical sessions.
  title              String?
  status             SessionStatus @default(NOT_STARTED)
  order              Int
  durationMin        Int           @default(60)
  assessorId         String?
  assessorName       String?
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  notes              String?
  meetingLink        String?
  calendarEventId    String?
  meetingScheduledAt DateTime?
  recordingLink      String?
  recordingFileId    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, type])
}

/// In-app notification for a single recipient. Mirrored to email on creation
/// (best-effort) so recipients are reached even when the app is closed.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  /// Relative in-app link to the related request/assessment.
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// A user's self-tracked progress on a single tech-matrix topic at one grade
/// band. `resolvedSkills` holds the individual skill strings the user has ticked
/// off for that (topic, grade); combined with assessment-derived scores by
/// lib/roadmap.ts to compute node status. `done` is legacy (pre per-skill
/// tracking) — still read as "all skills resolved" but no longer written.
model RoadmapProgress {
  id             String   @id @default(cuid())
  userId         String
  sectionId      String // denormalized (mirrors SelfAssessment) so the toggle writes without loading the matrix
  topicId        String
  grade          String // base band: "jun" | "mid" | "sen"
  resolvedSkills String[] @default([]) // individual skill strings ticked at this (topic, grade)
  done           Boolean  @default(true) // legacy: pre per-skill tracking; read as "all resolved"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId, grade])
  @@index([userId])
}

model SelfAssessment {
  id           String   @id @default(cuid())
  assessmentId String
  sectionId    String
  topicId      String
  score        Int? // 0-10 self rating; range enforced at API edge
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, topicId])
}

/// Admin-managed template that drives session generation for new assessments.
/// One row per (assessmentType, gradeBand, session). buildSessionsForGrade()
/// reads these ordered by `order`; falls back to hardcoded defaults when empty.
model SessionTemplate {
  id             String             @id @default(cuid())
  assessmentType AssessmentTypeEnum
  gradeBand      String // base band: "jun" | "mid" | "sen"
  key            String // stable slug written to AssessmentSession.type
  title          String // display name, e.g. "Technical 1"
  order          Int
  durationMin    Int                @default(60)
  enabled        Boolean            @default(true) // toggled off = skipped when generating sessions
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([assessmentType, gradeBand, key])
  @@index([assessmentType, gradeBand])
}

/// Editable technical matrix — a section groups related topics. String `id` is
/// preserved from the seed JSON so RoadmapProgress / SelfAssessment references
/// (which key on section/topic id strings) stay valid across the DB migration.
model MatrixSection {
  id        String   @id
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics MatrixTopic[]
}

/// A topic inside a section. `jun`/`mid`/`sen` hold the individual skill
/// strings ("questions") per grade band — kept as string arrays so they keep
/// matching RoadmapProgress.resolvedSkills exactly.
model MatrixTopic {
  id        String   @id
  sectionId String
  title     String
  order     Int
  jun       String[] @default([])
  mid       String[] @default([])
  sen       String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section MatrixSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

/// AI-generated "Topic of the day" shown on the dashboard. One row per calendar
/// day (server-local "YYYY-MM-DD"); generated lazily on first view and cached so
/// everyone sees the same topic that day. `resources` is [{ label, url }].
model DailyTopic {
  id        String   @id @default(cuid())
  date      String   @unique // "YYYY-MM-DD"
  kind      String // "concept" | "problem"
  title     String
  category  String // short tag, e.g. "Algorithms", "JavaScript"
  summary   String // 1-2 sentence hook
  detail    String // main explanation / problem + solution walkthrough
  code      String? // optional illustrative snippet
  resources Json // [{ label: string, url: string }]
  createdAt DateTime @default(now())
}
