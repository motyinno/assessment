# Copy to .env on the server and fill in values:
#   cp .env.production.example .env
# Generate AUTH_SECRET with: openssl rand -base64 32

# ---- Public URL / reverse proxy ----
DOMAIN=example.com
NEXTAUTH_URL=https://example.com

# ---- NextAuth ----
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL_DOMAIN=innowise.com

# ---- AI / Google ----
GEMINI_API_KEY=
# Optional: override the Gemini model (e.g. if the default preview model is
# overloaded/deprecated). Leave empty to use the built-in default.
GEMINI_MODEL=
GOOGLE_DRIVE_PDP_FOLDER_ID=
# Optional default guest auto-invited to every assessment Meet event.
# Each assessment may also override this via its own optionalGuestEmail field.
# Leave empty to disable.
OPTIONAL_MEETING_GUEST_EMAIL=

# ---- Cron ----
# Shared secret for the nightly "Topic of the day" job. The docker-compose
# `cron` service sends it as a Bearer token to /api/cron/daily-topic.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ---- Email notifications (Resend) ----
# Get a key at https://resend.com (free tier: 3k/mo). Leave RESEND_API_KEY
# empty to disable email; in-app notifications still work.
# EMAIL_FROM must use a domain verified in Resend (or its onboarding@resend.dev
# sandbox address for testing).
RESEND_API_KEY=
EMAIL_FROM="Node Assessment <notifications@example.com>"

# ---- HRM ----
# Keycloak token endpoint for the HRM technical user.
# prod: https://keycloak.innowise.com  |  stage: https://hrm-stage.inno.ws
HRM_KEYCLOAK_URL=
# Realm in the Keycloak token path. Leave empty to use "innowise-group".
HRM_KEYCLOAK_REALM=
# client_id sent in the Keycloak token request body. Leave empty to use "innowise-group".
HRM_KEYCLOAK_CLIENT_ID=
# Keycloak 17+ dropped the "/auth" prefix from its paths. The default below is
# confirmed on stage only; prod (keycloak.innowise.com) is a structurally
# different deployment and may need "/realms/{realm}/protocol/openid-connect/token"
# instead. Leave empty to use "/auth/realms/{realm}/protocol/openid-connect/token".
HRM_KEYCLOAK_TOKEN_PATH=
# HRM API base URL.
# prod: https://hrm.innowise.com  |  stage: https://hrm-stage.inno.ws
HRM_API_URL=
# Technical user with the EMPLOYEE role. Both required — empty HRM_PASSWORD
# throws a named config error instead of silently sending "undefined".
HRM_USERNAME=
HRM_PASSWORD=
# The only rollback switch: sync, employee refresh AND avatars (see S12) all
# gate on this — flipping it off in an incident also dims avatars everywhere.
# Leave unset/false to keep current behavior; set to exactly "true" to enable.
HRM_SYNC_ENABLED=false
# Page size for employees/v2/search. Leave empty to use 100.
HRM_SYNC_PAGE_SIZE=
# Per-request timeout in ms. Leave empty to use 20000.
HRM_HTTP_TIMEOUT_MS=
# TOTAL attempts (not retries on top of the first try) on a retryable error.
# Leave empty to use 3.
HRM_HTTP_RETRIES=
# "Refresh a bit early" window (ms) for both the access token and the photo
# file token — a cached token is treated as stale this long before its real
# expiry. Leave empty to use 60000.
HRM_TOKEN_REFRESH_WINDOW_MS=
# Access token TTL (ms) assumed when neither the JWT's exp claim nor
# Keycloak's expires_in is readable. Leave empty to use 60000.
HRM_TOKEN_FALLBACK_TTL_MS=
# Photo file-token TTL (ms) assumed when its expiry claim is unreadable or
# implausible. HRM docs it as "~5 min" — this defaults shorter on purpose.
# Leave empty to use 240000.
HRM_FILE_TOKEN_FALLBACK_TTL_MS=
# A parsed file-token expiry further than this from "now" is treated as
# implausible and replaced by the fallback above, so a nonsense value can't
# pin a dead token in the cache forever. Leave empty to use 3600000.
HRM_FILE_TOKEN_MAX_TTL_MS=
# Optional: UUID of a language to prefer when HRM dictionaries send more than
# one translation per value (defaultLanguageOnly=false). Leave empty unless
# stage shows nonzero dictionary collisions.
HRM_DICT_LANGUAGE_ID=
# Guard threshold (S04): abort the nightly sync without writing anything if
# more than this fraction of currently-active users would be archived in one
# run. Leave empty to use 0.2 (20%).
HRM_SYNC_MAX_DISMISS_RATIO=
# Guard threshold (S04): abort the nightly sync without writing anything if
# more than this many people would be newly granted ADMIN in one run. Leave
# empty to use 3. Unused until S05 wires up the auto-role-grant pass.
HRM_SYNC_MAX_ADMIN_GRANTS=
# Cron schedule (crontab syntax, container TZ) for the nightly HRM sync.
# Leave empty to use "0 3 * * *" (03:00).
HRM_SYNC_CRON=
# Timezone for the `cron` service's crontab. Leave empty to use Europe/Warsaw.
TZ=

# ---- Postgres ----
POSTGRES_USER=pdp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pdp
DATABASE_URL=postgresql://pdp:change-me@db:5432/pdp

# ENABLE_DEV_LOGIN intentionally unset in production.
